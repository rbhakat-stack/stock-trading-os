# Supabase — free tier: https://supabase.com
# Create a project, then Project Settings -> API to find these two values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Base URL Supabase redirects back to after email verification / password reset.
# Local development: http://localhost:8501 (matches `streamlit run app/main.py` default port).
# Production: your deployed app's URL, e.g. https://your-production-domain.com
# This is the ONLY thing that changes between local and production — no code change needed.
# Must also be added to Supabase's Authentication -> URL Configuration -> Redirect URLs (see README.md).
APP_URL=http://localhost:8501

# Alpaca — optional for Phase 1. Free paper account: https://alpaca.markets
# Leave both blank to run on built-in synthetic demo data instead of real market data.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# SERVER SIDE ONLY — NEVER EXPOSE TO CLIENT.
# Required for the Admin Console (user management, roles, audit log, system controls).
# Get it from Supabase: Project Settings -> API -> service_role key ("secret", not the
# anon/publishable key above). This key bypasses Row Level Security and can read/modify
# any user's data — never commit a real value, never put it in .env.example, never send
# it to the browser, never log it. Leave blank if you aren't using the Admin Console yet;
# admin pages will show "Administrative backend is not configured." instead of crashing.
SUPABASE_SERVICE_ROLE_KEY=
